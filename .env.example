# Shared checkout backend (required on Vercel preview/production)
#
# 1. Vercel → Project → Storage → Create Neon Postgres (or Vercel Postgres)
#    Copy DATABASE_URL (Neon also provides POSTGRES_URL — either works)
# 2. Vercel → Storage → Create Blob store
#    Copy BLOB_READ_WRITE_TOKEN
# 3. Redeploy the preview so env vars are available
#
# Local `next dev` can run WITHOUT these — it uses a server-side file store
# in .data/ so two browser profiles on the same machine still share CRs.
# That file store is NEVER used on Vercel / production.

DATABASE_URL=
# POSTGRES_URL=
BLOB_READ_WRITE_TOKEN=

# Optional Slack copy after a CR is saved to Neon (Office is still the record)
# SLACK_WEBHOOK_RADCABCR=
# SLACK_WEBHOOK_RAD_CAB_REPAIRS=

# Light office PIN for review (default 1357)
OFFICE_PIN=1357

# Testing only — skip required photos in the driver flow
# NEXT_PUBLIC_SKIP_PHOTOS=true
