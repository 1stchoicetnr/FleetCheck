# Copy to .env.local. Full shared-backend notes: .env.example
#
# Local `next dev` works WITHOUT these — checkout reports persist in .data/
# on this machine (shared across browser profiles on the same computer).
# Preview / production MUST set DATABASE_URL + BLOB_READ_WRITE_TOKEN on Vercel.

# DATABASE_URL=postgres://...
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# OFFICE_PIN=1357

# Optional: skip the photo step in local demo
# NEXT_PUBLIC_SKIP_PHOTOS=true
