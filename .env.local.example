# Copy to .env.local. Full shared-backend notes: .env.example
#
# Local `next dev` works WITHOUT these — checkout reports persist in .data/
# on this machine (shared across browser profiles on the same computer).
# Preview / production MUST set DATABASE_URL + BLOB_READ_WRITE_TOKEN on Vercel.

# DATABASE_URL=postgres://...
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# OFFICE_PIN=1357

# App feedback → Slack incoming webhook. Office still stores a copy.
# SLACK_WEBHOOK_FEEDBACK=https://hooks.slack.com/services/...
# Optional email fallback when the Slack webhook is unset:
# RESEND_API_KEY=re_...
# FEEDBACK_FROM_EMAIL=FleetCheck <noreply@warecovery.com>
# FEEDBACK_TO_EMAIL=ashley@warecovery.com

# Optional: skip the photo step in local demo
# NEXT_PUBLIC_SKIP_PHOTOS=true
