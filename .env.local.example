# Testing only — copy to .env.local if needed

# When true, skips the entire photo step and jumps to mileage
# NEXT_PUBLIC_SKIP_PHOTOS=true

# Slack channel IDs (defaults shown — override if needed)
# SLACK_CHANNEL_RAD_CAB_REPAIRS=C09K8F5F05U
# SLACK_CHANNEL_EQUIPMENT_ISSUES=CJU3KD10D

# Slack webhooks (required to actually post — create in Slack for each channel)
# SLACK_WEBHOOK_RAD_CAB_REPAIRS=https://hooks.slack.com/services/...
# SLACK_WEBHOOK_EQUIPMENT_ISSUES=https://hooks.slack.com/services/...

# Note: npm run dev already enables browse-without-photo mode automatically.
# Production builds require photos unless NEXT_PUBLIC_SKIP_PHOTOS=true (don't use in prod).
